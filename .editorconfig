root = true

[*]
charset                  = utf-8
end_of_line              = lf
indent_style             = tab
indent_size              = 2
insert_final_newline     = true
trim_trailing_whitespace = true

[*.{sh,bash}]
switch_case_indent = true
space_redirects    = true
binary_next_line   = true
function_next_line = true

[*.{yaml,yml}]
indent_style = space

[*.toml]
indent_style = space

[{LICENSE,*.md}]
indent_style = unset

[*.md]
trim_trailing_whitespace = unset

[**/testdata/**]
charset                  = unset
end_of_line              = unset
indent_style             = unset
indent_size              = unset
insert_final_newline     = unset
trim_trailing_whitespace = unset
